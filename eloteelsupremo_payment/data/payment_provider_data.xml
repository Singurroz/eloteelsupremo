<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_store_payment" model="payment.provider">
        <field name="name">Recarga / Pago en sucursal</field>
        <field name="code">custom</field>
        <field name="custom_mode">store_payment</field>
        <field name="state">enabled</field>
        <field name="is_published">True</field>
        <field name="pending_msg" type="html">
            <div>
                <h5>Acude a tu sucursal Elote El Supremo</h5>
                <p>Presenta tu número de pedido en caja para completar tu recarga en efectivo.</p>
                <p>El saldo se acreditará en tu Moned Supreme al confirmar el pago.</p>
            </div>
        </field>
        <field name="payment_method_ids"
               eval="[(6, 0, [ref('payment_method_store_payment')])]"/>
    </record>
</odoo>
