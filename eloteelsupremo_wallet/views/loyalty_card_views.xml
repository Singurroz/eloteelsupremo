<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_card_view_form_supreme" model="ir.ui.view">
        <field name="name">loyalty.card.form.supreme</field>
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="supreme_member_number"/>
            </xpath>
        </field>
    </record>
</odoo>
