<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_supreme" model="ir.ui.view">
        <field name="name">pos.config.form.supreme</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting string="QR Banco Supremo" help="Permite escanear códigos QR de clientes Moned Supreme">
                    <field name="supreme_qr_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
