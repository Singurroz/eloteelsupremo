<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_supreme" model="ir.module.category">
        <field name="name">Banco Supremo</field>
        <field name="description">Moned Supreme, Puntos Supremos y QR</field>
        <field name="sequence">45</field>
    </record>

    <record id="res_groups_privilege_supreme" model="res.groups.privilege">
        <field name="name">Banco Supremo</field>
        <field name="category_id" ref="module_category_supreme"/>
    </record>

    <record id="group_supreme_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_supreme"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_supreme_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_supreme"/>
        <field name="implied_ids" eval="[(4, ref('group_supreme_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
