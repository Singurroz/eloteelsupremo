<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Moned Supreme (eWallet) -->
    <record id="loyalty_program_moned_supreme" model="loyalty.program">
        <field name="name">Moned Supreme</field>
        <field name="program_type">ewallet</field>
        <field name="supreme_program_kind">moned</field>
        <field name="applies_on">future</field>
        <field name="trigger">auto</field>
        <field name="portal_visible">True</field>
        <field name="portal_point_name">MS</field>
    </record>

    <record id="loyalty_rule_moned_supreme" model="loyalty.rule">
        <field name="program_id" ref="loyalty_program_moned_supreme"/>
        <field name="reward_point_amount">1</field>
        <field name="reward_point_mode">money</field>
        <field name="reward_point_split">False</field>
        <field name="product_ids" eval="[(4, ref('product_recharge_moned_supreme'))]"/>
    </record>

    <record id="loyalty_reward_moned_supreme" model="loyalty.reward">
        <field name="program_id" ref="loyalty_program_moned_supreme"/>
        <field name="reward_type">discount</field>
        <field name="discount_mode">per_point</field>
        <field name="discount">1</field>
        <field name="discount_applicability">order</field>
        <field name="required_points">1</field>
        <field name="description">Moned Supreme</field>
    </record>

    <!-- Puntos Supremos (loyalty) -->
    <record id="loyalty_program_puntos_supremos" model="loyalty.program">
        <field name="name">Puntos Supremos</field>
        <field name="program_type">loyalty</field>
        <field name="supreme_program_kind">puntos</field>
        <field name="applies_on">both</field>
        <field name="trigger">auto</field>
        <field name="portal_visible">True</field>
        <field name="portal_point_name">PS</field>
    </record>

    <record id="loyalty_rule_puntos_supremos" model="loyalty.rule">
        <field name="program_id" ref="loyalty_program_puntos_supremos"/>
        <field name="reward_point_amount">1</field>
        <field name="reward_point_mode">money</field>
        <field name="minimum_amount">0</field>
    </record>

    <record id="loyalty_reward_puntos_supremos" model="loyalty.reward">
        <field name="program_id" ref="loyalty_program_puntos_supremos"/>
        <field name="reward_type">discount</field>
        <field name="discount_mode">percent</field>
        <field name="discount">1</field>
        <field name="discount_applicability">order</field>
        <field name="required_points">1</field>
        <field name="description">Canje Puntos Supremos</field>
    </record>
</odoo>
